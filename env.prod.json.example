{
  "API_BASE_URL": "https://api.dony.app/api/v1",
  "_comment_poster_share_base_url": "Domaine nu des liens partagés (affiche de trajet, demande d'envoi). Vide → repli sur API_BASE_URL : le lien partagé porte l'origine de l'API (lib/core/config/api_config.dart).",
  "POSTER_SHARE_BASE_URL": "https://yadony.com",
  "PRO_PORTAL_URL": "https://yadony.com/pro",
  "FIREBASE_PROJECT_ID": "your-firebase-project-id",
  "FIREBASE_MESSAGING_SENDER_ID": "your-messaging-sender-id",
  "FIREBASE_STORAGE_BUCKET": "your-project-id.firebasestorage.app",
  "FIREBASE_ANDROID_API_KEY": "your-android-api-key",
  "FIREBASE_ANDROID_APP_ID": "1:xxx:android:xxx",
  "FIREBASE_IOS_API_KEY": "your-ios-api-key",
  "FIREBASE_IOS_APP_ID": "1:xxx:ios:xxx",
  "_comment_environment": "Valeur attendue en production : \"production\". Vide → lib/main.dart retombe sur le défaut \"development\" (options.environment) : les plantages de production sont classés en développement dans Sentry.",
  "ENVIRONMENT": "production",
  "STRIPE_PUBLISHABLE_KEY": "pk_live_your_stripe_live_key",
  "SENTRY_DSN": "https://your_key@sentry.io/your_project_id",
  "_comment_google_maps": "Deux clés distinctes. GOOGLE_MAPS_API_KEY = clé iOS (yadony-prod-ios, lue par Info.plist/xcconfig). GOOGLE_MAPS_ANDROID_API_KEY = clé Android (yadony-prod-android, restreinte com.yadony.yadony + SHA-1), lue par android/app/build.gradle.kts pour le manifest. Obligatoire en production : sans elle le build release Android échoue ; la clé iOS dans le manifest Android donne une carte vide (build 143, YADONY-FLUTTER-PROD-1T).",
  "GOOGLE_MAPS_API_KEY": "your-google-maps-ios-api-key",
  "GOOGLE_MAPS_ANDROID_API_KEY": "your-google-maps-android-api-key",
  "POSTHOG_API_KEY": "phc_your_posthog_project_key",
  "POSTHOG_HOST": "https://eu.i.posthog.com",
  "_comment_tls_pinning": "Valeur attendue en production : \"on\". Vide → aucun épinglage de certificat en production (lib/core/network/api_client.dart).",
  "TLS_PINNING": "on"
}
