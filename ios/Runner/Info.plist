<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Yadony</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Sans cette clé, iOS ne propose que la langue de développement dans
	     Réglages > Yadony > Langue, et la Locale système peut être rabattue
	     dessus au lieu des langues réellement embarquées par l'app. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>fr</string>
		<string>en</string>
	</array>
	<key>CFBundleName</key>
	<string>Yadony</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<!-- Le moteur Flutter livre sinon l'URI brute au routeur, en doublon
	     d'app_links : GoRouter recevait `yadony://stripe/onboarding/refresh`
	     schéma compris, ne trouvait aucune route et affichait « Page Not
	     Found ». Android posait déjà ce réglage à false ; iOS l'ignorait,
	     d'où une asymétrie entre les deux plateformes. Les liens entrants
	     passent tous par _handleDeepLink, qui filtre par liste blanche. -->
	<key>FlutterDeepLinkingEnabled</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>yadony</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>yadony</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>firebase-phone-auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(FIREBASE_PHONE_AUTH_URL_SCHEME)</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>google-sign-in</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GID_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>FirebaseAppDelegateProxyEnabled</key>
	<false/>
	<key>GIDClientID</key>
	<string>$(GID_CLIENT_ID)</string>
	<key>GMSApiKey</key>
	<string>$(GOOGLE_MAPS_API_KEY)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
		<string>mailto</string>
		<string>https</string>
		<string>sms</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Autorise le HTTP en clair vers le réseau local uniquement. Le backend
	     de développement est joint sur une IP privée (cf. env.dev.json), qu'ATS
	     bloquerait sinon. Contrairement à NSAllowsArbitraryLoads, cette clé
	     n'appelle aucune justification auprès d'Apple. Info.plist étant unique
	     et partagé entre Debug et Release, la retirer casserait le
	     développement de toute l'équipe sans rien apporter à la revue. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Phrases de permission. Elles sont traduites dans
	     en.lproj/InfoPlist.strings et fr.lproj/InfoPlist.strings : les valeurs
	     ci-dessous ne servent que de repli. Chaque phrase doit citer TOUS les
	     usages réels (guideline 5.1.1), à reporter dans les deux traductions. -->
	<key>NSCameraUsageDescription</key>
	<string>Yadony utilise l'appareil photo pour scanner les QR codes des colis, photographier vos colis, envoyer des photos dans la messagerie, vérifier votre identité (photo de votre pièce et selfie) et scanner votre carte bancaire.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Yadony utilise Face ID pour déverrouiller l'application et confirmer vos paiements, si vous activez cette protection.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Yadony utilise votre position pendant que vous utilisez l'application pour afficher les trajets et colis près de chez vous, trouver l'aéroport le plus proche et enregistrer le lieu de chaque étape de remise d'un colis.</string>
	<!-- Appels audio Yadony (Stream Video). -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Yadony utilise le micro pour vos appels audio avec l'expéditeur, le voyageur ou le destinataire d'un colis, et pour dicter un trajet ou une demande d'envoi à l'assistant IA.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Yadony convertit votre voix en texte avec la reconnaissance vocale d'Apple pour remplir un trajet ou une demande d'envoi avec l'assistant IA.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Yadony enregistre dans vos photos le QR code de votre colis et les affiches de vos annonces, pour les retrouver hors ligne ou les partager.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Yadony accède à vos photos pour joindre des images de colis, choisir votre photo de profil et envoyer des photos dans la messagerie ou au support.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>audio</string>
		<string>voip</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIStatusBarHidden</key>
	<false/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>telephony</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>com.posthog.posthog.AUTO_INIT</key>
	<false/>
</dict>
</plist>
